# ==============================================================================
# .gitignore cho Meetly STT Research Benchmark Framework
# ==============================================================================

# 1. Môi trường ảo Python (Virtual Environments)
.venv/
venv/
env/
ENV/
env.bak/
venv.bak/

# 2. Bytecode & Cache của Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python

# 3. Cache kiểm thử & Phân tích tĩnh (Testing & Linting)
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.mypy_cache/
.ruff_cache/
.tox/
.nox/

# 4. Hugging Face & Bộ nhớ đệm Trọng số Mô hình (Model Weights & Cache)
# Không commit model weights (hàng trăm MB - vài GB) lên repository Git
.cache/
hf_cache/
models/
downloaded_models/
ct2_models/
checkpoints/
*.pt
*.pth
*.bin
*.onnx
*.safetensors

# 5. Dữ liệu âm thanh lớn & Tệp nén (Large Audio & Archive Files)
*.tar.gz
*.zip
*.7z
*.rar

# 6. Tệp Đa phương tiện tạm thời
*.mp4
*.mkv
*.avi
*.mov
*.flv
extracted_*.wav
*.tmp
temp/
tmp/

# 7. Jupyter Notebook Checkpoints
.ipynb_checkpoints/
*-checkpoint.ipynb

# 8. Cấu hình IDE & Môi trường lập trình
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
desktop.ini

# 9. Tệp nhật ký & Tệp tạm thời hệ thống
*.log
nohup.out

# 10. Bảo mật & Thông tin xác thực (Credentials & Secrets)
# Tuyệt đối không commit key, token hay mật khẩu
*.pem
*.key
*.token
.env
.env.*
!.env.example
